# ============================================================
# IELTSUZ — Environment Variables
# Copy this file to .env.local and fill in real values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ============================================================

# --- Supabase (required) ------------------------------------
# Project URL and the public (anon / publishable) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Service-role key (server-only, NEVER exposed to the browser).
# Used for code-based payment verification and the admin analytics dashboard.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# --- Google Gemini (required) -------------------------------
# Powers speaking/writing evaluation, coaching, transcription, payment OCR.
GEMINI_API_KEY=your-gemini-api-key
# Optional spare keys — used automatically when the primary key is rate-limited.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# Optional: override the evaluation model (defaults to gemini-2.5-flash).
# EVAL_MODEL=gemini-2.5-flash
# Optional: model for live speaking partner/examiner turns.
# PARTNER_MODEL=gemini-2.5-flash
# Gemini Live model — the examiner's real-time voice path. Measured reply
# latency on this default is ~1.2-1.8s vs ~3.8s for the 2.5 native-audio models.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# End-of-speech silence window in ms. Lower = the examiner replies sooner;
# too low and it cuts in while the candidate is thinking. Part 2 uses 3x this.
# LIVE_SILENCE_MS=250

# --- ElevenLabs TTS (required for live AI examiner voice) ---
# Natural human-like voice for the speaking partner/examiner (ielts.gg style).
ELEVENLABS_API_KEY=
# Voice ID — pick a mature, calm native-English voice from the ElevenLabs
# library (default: George, JBFqnCBsd6RMkjVDRZzb).
ELEVENLABS_VOICE_ID=
# Optional: primary/fallback TTS models (defaults: eleven_turbo_v2_5 /
# eleven_flash_v2_5). Flash/turbo do NOT support Uzbek — Uzbek lines are shown
# on screen only unless TTS_SPEAK_UZBEK=1 (then routed to
# ELEVENLABS_UZBEK_MODEL_ID, default eleven_multilingual_v2, accent imperfect).
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# ELEVENLABS_FALLBACK_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_UZBEK_MODEL_ID=eleven_multilingual_v2
# TTS_SPEAK_UZBEK=0
# Optional: set to "gemini" to use Gemini TTS for greetings instead of ElevenLabs.
# TTS_PROVIDER=elevenlabs

# --- Speaking examiner: abuse protection -------------------------
# Hard cap on one live speaking session (minutes). Turns after this are
# rejected and the client ends the test and shows the report.
SPEAKING_MAX_SESSION_MIN=20
# Secret used to sign session tokens. Any long random string. Falls back to
# SUPABASE_SERVICE_ROLE_KEY when empty.
SPEAKING_SESSION_SECRET=

# --- Payment / Card details (required for Pro upgrades) -----
# The card users transfer money to. NEXT_PUBLIC_ version is shown in the UI;
# the server version is used by the screenshot-verification OCR.
NEXT_PUBLIC_CARD_NUMBER=8600123456789012
CARD_NUMBER=8600123456789012
NEXT_PUBLIC_CARD_OWNER=IELTSUZ
CARD_OWNER=IELTSUZ
# Monthly Pro price in UZS.
MONTHLY_PRICE_UZS=49000

# --- Optional: Payme merchant API (auto-verification) -------
# Leave blank to use manual screenshot verification only.
# PAYME_MERCHANT_ID=
# PAYME_API_KEY=

# --- SEO / Site URL (recommended) ---------------------------
# Public canonical URL of the site. Used for sitemap, robots,
# canonical tags and Open Graph. Set to your real domain.
NEXT_PUBLIC_SITE_URL=https://ieltsuz.com
# Optional: shown in structured data (JSON-LD) offer price.
# NEXT_PUBLIC_MONTHLY_PRICE_UZS=49000

# --- Optional: external API base (leave blank for same-origin) ---
# NEXT_PUBLIC_API_URL=
