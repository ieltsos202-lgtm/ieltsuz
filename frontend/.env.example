# ============================================================
# IELTS OS — Environment Variables
# Copy this file to .env.local and fill in real values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ============================================================

# --- Supabase (required) ------------------------------------
# Project URL and the public (anon / publishable) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Service-role key (server-only, NEVER exposed to the browser).
# Used for code-based payment verification and the admin analytics dashboard.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# --- Google Gemini (required) -------------------------------
# Powers speaking/writing evaluation, coaching, transcription, payment OCR.
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the evaluation model (defaults to gemini-2.5-flash).
# EVAL_MODEL=gemini-2.5-flash
# Optional: model for live speaking partner/examiner turns.
# PARTNER_MODEL=gemini-2.5-flash

# --- ElevenLabs TTS (required for live AI examiner voice) ---
# Natural human-like voice for the speaking partner/examiner (ielts.gg style).
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional: voice ID (default: Adam — pNInz6obpgDQGcFmaJgB).
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Optional: TTS model (default: eleven_turbo_v2_5 — fastest + most natural).
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Optional: set to "gemini" to use Gemini TTS instead of ElevenLabs.
# TTS_PROVIDER=elevenlabs

# --- Payment / Card details (required for Pro upgrades) -----
# The card users transfer money to. NEXT_PUBLIC_ version is shown in the UI;
# the server version is used by the screenshot-verification OCR.
NEXT_PUBLIC_CARD_NUMBER=8600123456789012
CARD_NUMBER=8600123456789012
NEXT_PUBLIC_CARD_OWNER=IELTSUZ
CARD_OWNER=IELTSUZ
# Monthly Pro price in UZS.
MONTHLY_PRICE_UZS=49000

# --- Optional: Payme merchant API (auto-verification) -------
# Leave blank to use manual screenshot verification only.
# PAYME_MERCHANT_ID=
# PAYME_API_KEY=

# --- SEO / Site URL (recommended) ---------------------------
# Public canonical URL of the site. Used for sitemap, robots,
# canonical tags and Open Graph. Set to your real domain.
NEXT_PUBLIC_SITE_URL=https://ieltsuz.com
# Optional: shown in structured data (JSON-LD) offer price.
# NEXT_PUBLIC_MONTHLY_PRICE_UZS=49000

# --- Optional: external API base (leave blank for same-origin) ---
# NEXT_PUBLIC_API_URL=
